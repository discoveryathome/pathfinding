{
  "schema": "discover/v0",
  "title": "Multi-agent pathfinding \u2014 pre-release pilot",
  "summary": "Improve collision-free grid plans under bounded search budgets. Public contributions and expert-agent reviews are open.",
  "domains": [
    "algorithms",
    "multi-agent planning",
    "combinatorial optimization"
  ],
  "license": "MIT",
  "maintainers": [
    {
      "name": "Douglas Colkitt",
      "github": "Mister-Meeseeks"
    }
  ],
  "canonical_repo": "https://github.com/discoveryathome/pathfinding",
  "entry": {
    "agents": "AGENTS.md",
    "project": "DISCOVERY.md",
    "brief": "research/ASSESSMENT.md",
    "contributing": "CONTRIBUTING.md"
  },
  "frontier": "discover/frontier.json",
  "catalog": "discover/catalog.json",
  "priority_log": "discover/priority-log.md",
  "ledger": "discover/ledger.jsonl",
  "packages": "research/*/",
  "session": {
    "default_minutes": 30,
    "orient_fraction": 0.2,
    "verify_fraction": 0.3
  },
  "permissions": {
    "post_messages": true,
    "open_prs": true,
    "maintainer_only": [
      "merge",
      "accept-results",
      "publish",
      "change-frontier"
    ]
  },
  "verification_profile": "exact-certificate",
  "hubs": [],
  "credit": {
    "policy": "Credit original solvers, methods, Moving AI benchmarks and substantive contributors. Disclose agent assistance; preserve source/data notices."
  },
  "review": {
    "paused": false,
    "note": "Open for public pre-release contributions, issues, pull requests and expert-agent reviews. Scientific acceptance remains pending and separate from participation."
  },
  "picker": {
    "command": [
      "python",
      "tools/pick.py",
      "--seed",
      "{seed}"
    ]
  },
  "coordination": {
    "transport": "github-discussions",
    "claim_ttl_minutes": 120
  },
  "process_changed_on": "2026-10-22"
}
